          "logic"
        ],
        "additionalProperties": false
      },
      "examples": [
        {
          "path": "/assigned/goal/basic.py",
          "class_name": "Basic",
          "method_name": "execute",
          "logic": "if a < 0:\n    return 0\nreturn a + b",
