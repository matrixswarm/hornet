        "mcp.radd_file_editor"
      ],
      "description": "Read or edit lines; return source hash. All line numbers are 1-based.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "read_lines",
              "create_file",
              "replace_line",
              "insert_line",
              "delete_line"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Explicit target file on the MCP server host. Use the assigned goal workspace."
          },
          "start": {
            "type": "integer",
            "minimum": 1
          },
          "end": {
            "type": "integer",
            "minimum": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string"
          },
          "commit": {
            "type": "boolean",
            "default": true,
            "description": "false stages a unique preview; true recomputes and commits this call."
          },
          "expected_sha256": {
            "type": "string",
            "minLength": 1,
            "description": "Required to commit an existing-file edit. Copy source_sha256 from a read/preview; stale hashes are rejected."
          }
        },
        "required": [
          "action",
          "path"
        ],
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "read_lines",
          "path": "/assigned/goal/example.py",
          "start": 1,
          "end": 20
        }
      ],
      "notes": "read_lines needs start/end only optionally; create_file requires text and refuses overwrite; replace/insert require line and text; delete requires line. Python/JSON edits must remain syntactically valid.",
      "mutates": true
    },
