        },
        {
          "path": "/assigned/goal/basic.py",
          "class_name": "Basic",
          "method_name": "execute",
          "logic": "value = a + b\nreturn value",
          "commit": false
        }
      ],
      "notes": "Ambiguous methods require class_name. Top-level functions/classes only. Inline one-line methods are rejected. Replaces the complete body including docstring; decorators stay unchanged. Does not turn an ABC into a concrete class. Body preparation is automatic: remove a common margin, parse, add target indentation and compile the entire candidate before any write. Do not indent a sequential return after a check call. Use recipe.precision_formatting for body-format diagnostics.",
      "mutates": true
    },
