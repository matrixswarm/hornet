    },
    {
      "uri": "files.text.indent",
      "path": "assets/precision_indenter.py",
      "type": "TOOL",
      "version": "2.1.0",
      "aliases": [
        "mcp.precision_indenter"
      ],
      "description": "Shift or dedent text; python_body prepares and parses a Python body without guessing nested logic.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "op": {
            "type": "string",
            "enum": [
              "stay",
              "indent",
              "outdent",
              "reset",
              "python_body"
            ],
            "description": "python_body removes a common margin and checks Python body syntax; it never flattens internal nesting."
          },
          "lang": {
            "type": "string",
            "enum": [
              "python",
              "javascript",
              "json",
              "yaml",
              "default"
            ]
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      },
      "examples": [
        {
          "text": "if ok:\n    run()",
          "op": "indent"
        },
        {
          "text": "    check(value)\n    return value",
          "op": "python_body",
          "lang": "python"
        }
      ],
      "notes": "Pure text operation: never reads/writes a project file. python_body is optional: method.fill and method.stage already use the same preparation automatically. A body parse does not establish validity in a specific function or correct behavior; insertion compiles the whole target and acceptance checks verify behavior. reset removes only a common margin; it cannot fix an individual misplaced indent.",
      "mutates": false
    },
    {
      "uri": "files.text.lines",
      "path": "assets/radd_file_editor.py",
      "type": "TOOL",
      "version": "2.0.0",
